# LifeLink frontend environment
#
# Leave VITE_API_BASE_URL empty to use the Vite dev-server proxy defined in
# vite.config.js (recommended for development - it makes requests same-origin
# so no CORS configuration is needed).
#
# Set it to an absolute origin only if you serve the built frontend separately
# from the API, e.g. VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=

# Where the dev-server proxy forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000
