# LifeLink FastAPI foundation
APP_NAME=LifeLink API
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api

# Use a dedicated PostgreSQL login in real deployments. Never commit its real
# password. SQLAlchemy selects psycopg's async implementation for this URL when
# the application creates an AsyncEngine.
DATABASE_URL=postgresql+psycopg://lifelink_user:change-me@localhost:5432/lifelink
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_HEALTH_TIMEOUT_SECONDS=3

FRONTEND_ORIGIN=http://localhost:5173

# Authentication/RBAC module. Generate a unique secret for every deployment;
# this visible value is only a development placeholder.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
